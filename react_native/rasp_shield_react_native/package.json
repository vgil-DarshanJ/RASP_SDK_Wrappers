{
  "name": "rasp-shield-react-native",
  "version": "1.1.0",
  "description": "RASP Shield for React Native - runtime application self-protection backed by the shared android-core engine: the same 43 on-device detectors, 5-state result contract and signed event shipping as the Flutter and Android Native SDKs. Android today; iOS is next.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "react-native.config.js",
    "README.md",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "rasp",
    "security",
    "root-detection",
    "frida",
    "tamper-detection",
    "banking"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.87.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "react-native",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "codegenConfig": {
    "name": "RNRaspShieldSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.shieldsdk.rasp.reactnative"
    }
  }
}
